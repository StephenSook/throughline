# Throughline — every variable here is read by the code. Nothing here is unused.
# Verify both directions before submission: grep the code for each name below,
# and grep the code for os.environ/settings reads not listed here.

# TimescaleDB (Tiger Cloud). Plain Postgres wire protocol.
# OPTIONAL. Unset, Throughline still computes and serves every figure live from
# source; only cross-run history is unavailable, and /api/storage says so.
# With it set, the divergence-rate chart is served from a continuous aggregate.
DATABASE_URL=postgres://tsdbadmin:password@host.tsdb.cloud.timescale.com:30133/tsdb?sslmode=require

# Google AI Studio key. Real keys start with "AIza".
GEMINI_API_KEY=AIza...

# Optional: override the pinned model ids used by the adjudication panel.
GEMINI_MODEL=gemini-3.6-flash
GEMMA_MODEL=gemma-4-31b-it

# Render sets PORT automatically. Local default is 8000.
PORT=8000
