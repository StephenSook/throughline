# Throughline — every variable here is read by the code. Nothing here is unused.
# Verify both directions before submission: grep the code for each name below,
# and grep the code for os.environ/settings reads not listed here.

# TimescaleDB (Tiger Cloud). Plain Postgres wire protocol.
# OPTIONAL. Unset, Throughline still computes and serves every figure live from
# source; only cross-run history is unavailable, and /api/storage says so.
# With it set, the divergence-rate chart is served from a continuous aggregate.
DATABASE_URL=postgres://tsdbadmin:password@host.tsdb.cloud.timescale.com:30133/tsdb?sslmode=require

# Google AI Studio key. Real keys start with "AIza".
GEMINI_API_KEY=AIza...

# DigitalOcean API token. Reaches Gradient serverless inference, which serves the
# panel's third voter on infrastructure independent of Google's.
# OPTIONAL: without it the panel runs with two seats and says so.
DIGITAL_OCEAN_API_KEY=dop_v1_...

# Snowflake Cortex — the panel's fourth seat, reached through the SQL API v2.
# The Cortex inference endpoint returns 403 on trial accounts; the SQL path
# works on the same keypair credentials.
# OPTIONAL: without these the panel seats three and reports that it did.
# Register the public half first:
#   ALTER USER <user> SET RSA_PUBLIC_KEY='<base64 body of the .pub, no headers>';
SNOWFLAKE_ACCOUNT=orgname-accountname
SNOWFLAKE_USER=YOUR_USER
SNOWFLAKE_PRIVATE_KEY='-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----'
SNOWFLAKE_WAREHOUSE=COMPUTE_WH
SNOWFLAKE_ROLE=ACCOUNTADMIN

# Optional: override the pinned model ids used by the adjudication panel.
GEMINI_MODEL=gemini-3.6-flash
GEMMA_MODEL=gemma-4-31b-it
DO_MODEL=openai-gpt-oss-120b
SNOWFLAKE_MODEL=llama3.3-70b

# Injected by the platform, not by you. Listed so this file is a complete
# account of what the running process reads.
#   PORT              set by Render; consumed by the uvicorn start command in
#                     render.yaml, not by Python. Local default is 8000.
#   RENDER_GIT_COMMIT set by Render; surfaced on /api/health so you can tell
#                     which commit is actually serving.
PORT=8000
