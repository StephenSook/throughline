# Throughline — every variable here is read by the code. Nothing here is unused.
# Verify both directions before submission: grep the code for each name below,
# and grep the code for os.environ/settings reads not listed here.

# Postgres / TimescaleDB (Tiger Cloud). Plain Postgres wire protocol.
DATABASE_URL=postgres://user:password@host.tsdb.cloud.timescale.com:30133/tsdb?sslmode=require

# Google AI Studio key. Real keys start with "AIza".
GEMINI_API_KEY=AIza...

# Optional: overrides the default model id.
GEMINI_MODEL=gemini-3.6-flash

# Render sets PORT automatically. Local default is 8000.
PORT=8000
